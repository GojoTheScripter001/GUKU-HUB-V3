-- PLAYER TAB
local function PlayerTab()
    clearContent()
    createLabel("PLAYER SETTINGS", 10)

    local speed = Instance.new("TextBox")
    speed.Size = UDim2.new(1, -20, 0, 40)
    speed.Position = UDim2.new(0, 10, 0, 60)
    speed.BackgroundColor3 = Black
    speed.TextColor3 = Yellow
    speed.PlaceholderText = "Enter WalkSpeed"
    speed.Text = "16"
    speed.Parent = Content
    Instance.new("UICorner", speed)

    local function applyStats()
        local humanoid = player.Character and
            player.Character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            local value = tonumber(speed.Text)
            if value then
                humanoid.WalkSpeed = math.clamp(value, 0, 100)
            end
        end
    end

    speed.FocusLost:Connect(applyStats)

    local jump = Instance.new("TextBox")
    jump.Size = UDim2.new(1, -20, 0, 40)
    jump.Position = UDim2.new(0, 10, 0, 115)
    jump.BackgroundColor3 = Black
    jump.TextColor3 = Yellow
    jump.PlaceholderText = "Enter JumpPower"
    jump.Text = "50"
    jump.Parent = Content
    Instance.new("UICorner", jump)

    jump.FocusLost:Connect(function()
        local humanoid = player.Character and
            player.Character:FindFirstChildOfClass("Humanoid")

        local value = tonumber(jump.Text)
        if humanoid and value then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = math.clamp(value, 0, 150)
        end
    end)
end

